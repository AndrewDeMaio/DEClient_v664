#ifndef __AUTOQAWORKS_H__
#define __AUTOQAWORKS_H__

#include "AutoQA.h"

class AQAWork_Base : public aqa::Work
{
public:
	AQAWork_Base(const std::string& name, const std::string& desc);
};


class AQAWork_Item : public AQAWork_Base
{
public:
	AQAWork_Item(const std::string& name, const std::string& desc);

};

//////////////////////////////////////////////////////////////////////////
// 달빛 상자 확률 테스트
// 2009.09.23
class AQAWork_MoonlightBox : public AQAWork_Item
{
public:
	AQAWork_MoonlightBox();

	virtual void Do(aqa::IFunctions& func, aqa::IReport& report);
};

//////////////////////////////////////////////////////////////////////////
// 보물상자
// 2009.09.23
class AQAWork_NormalCase : public AQAWork_Item
{
public:
	AQAWork_NormalCase(int itemType);

	virtual void Do(aqa::IFunctions& func, aqa::IReport& report);

	int m_ItemType;
};


#endif	//__AUTOQAWORKS_H__
